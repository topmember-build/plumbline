# Copy this file to .env and fill it in. Never commit .env.

# NEAR AI Cloud (https://cloud.near.ai). Needed for the AI explanation and for `npm run verify`.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# NEAR Intents (1Click API). A JWT is optional; it can remove the protocol's extra fee on quotes.
ONECLICK_JWT=

# Used for payment orders, saving demo quotes (demo-fixtures.ts) and the live swap form.
# REFUND_TO: a NEAR account that gets the trader's funds back if a payment fails.
#            Also the placeholder destination for dry quotes into NEAR-chain tokens.
REFUND_TO=
# RECIPIENT: any 0x address; the placeholder destination for dry quotes into EVM-chain tokens (no funds move).
RECIPIENT=

# Paid mode and payouts: the agent account that receives the fees (USDC on NEAR).
AGENT_ACCOUNT=
# Only for `npm run payout -- --send`. This key can move the agent's funds. Keep it in .env only.
AGENT_PRIVATE_KEY=

# Optional
# PORT=3000
# NEAR_RPC=https://rpc.mainnet.near.org
